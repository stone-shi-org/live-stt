# Copy to .env (gitignored) and adjust. See live_stt/config.py for the full
# list and defaults -- everything here is optional; unset vars fall back to
# the Settings defaults, which the Dockerfile's runtime stage also sets via
# ENV for the container-native paths (LSTT_WORKER_BIN, LSTT_MODELS_DIR, etc).

# LS-5: independent per-engine backend choice, replacing the old single
# LSTT_BACKEND switch -- e.g. run the live stream on GPU while whisper's
# batch HTTP path stays on CPU. Each defaults to "cpu".
# LSTT_PARAKEET_BACKEND=cpu
# LSTT_WHISPER_BACKEND=cpu
# LSTT_PARAKEET_TDT_BACKEND=cpu
# LSTT_DEFAULT_MODEL=realtime_eou_120m-v1
# LSTT_DEFAULT_BATCH_MODEL=realtime_eou_120m-v1
# LSTT_MAX_CONCURRENT_CALLS=3
# LSTT_RESERVE_SLOTS=1
# LSTT_N_THREADS_PER_WORKER=1

# Redaction -- see CLAUDE.md. Two independent switches; "full"/"sample:1inN"
# and any LSTT_AUDIO_DUMP other than "off" both require LSTT_ALLOW_PII=true,
# checked at startup (refuses to start otherwise, does not silently downgrade).
# LSTT_TRANSCRIPT_LOG=off
# LSTT_AUDIO_DUMP=off
# LSTT_ALLOW_PII=false
