data/
models/*.gguf
# whisper.cpp's own legacy ggml model format (NOT gguf -- see live_stt/models.py's docstring and
# CLAUDE.md's "Second engine: whisper.cpp"), fetched by scripts/fetch_model.sh same as the .gguf
# files above. Found missing here the hard way: models/ showed up as a whole untracked directory
# (multi-hundred-MB .bin files included) the first time a whisper model was fetched into it.
models/*.bin
.env
docker-compose.override.yml
venv/
.venv/
__pycache__/
*.pyc
*.db
*.db-wal
*.db-shm
test-reports/
coverage/
.pytest_cache/
version.txt

# generated protobuf stubs -- regenerated by scripts/gen_proto.sh, not checked in
live_stt/pb/

# C++ build output
worker/build/
worker/build-*/

# LS-5 Phase 7b: downloaded prebuilt backend artifacts (scripts/fetch_backend.sh /
# LSTT_PARAKEET_PREBUILT's PARAKEET_PREBUILT_DIR default) -- fetched binaries,
# not source, same reasoning as models/*.gguf below. Anchored to the repo
# root (leading /) -- an earlier version of this rule ("backends/", no
# leading slash) matched at ANY depth and was silently ignoring the real
# live_stt/backends/ Python package this same phase added, caught by
# noticing `git status` showed those new files as neither tracked nor
# untracked.
worker/prebuilt-*/
/backends/

# audio dumps (LSTT_AUDIO_DUMP), never committed
data/dumps/
